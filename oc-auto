# --- Session Discovery Across Adapters ---
list_agent_sessions() {
  local AGENT_KEY="$1"
  ensure_agents_config
  python3 - "$AGENTS_CFG" "$AGENT_KEY" "$PWD" << 'PY'
import json, os, sys, glob, sqlite3, datetime

cfg = json.load(open(sys.argv[1]))
key = sys.argv[2]
cwd = os.path.realpath(sys.argv[3])
meta = cfg.get(key, {})
parser = meta.get("parser", "git_diff")

def fmt_ts(ts):
    try:
        if ts > 1e12: ts /= 1000.0
        return datetime.datetime.fromtimestamp(ts).strftime("%m-%d %H:%M")
    except Exception:
        return "recent"

if parser == "sqlite_opencode":
    db = os.path.expanduser(meta.get("db", "~/.local/share/opencode/opencode.db"))
    if os.path.isfile(db):
        con = sqlite3.connect(db)
        cur = con.cursor()
        # Clean probe-only sessions automatically
        try:
            cur.execute("""
                DELETE FROM session WHERE id IN (
                  SELECT m.session_id FROM message m JOIN part p ON p.message_id = m.id
                  WHERE json_extract(p.data, '$.type') = 'text'
                    AND trim(json_extract(p.data, '$.text')) IN ('Reply READY', 'READY')
                )
            """)
            con.commit()
        except Exception:
            pass
        rows = cur.execute("""
            SELECT s.id, COALESCE(NULLIF(trim(s.title), ''), s.id), COALESCE(s.directory, ''), COALESCE(s.time_updated, s.time_created, 0)
            FROM session s
            WHERE EXISTS (SELECT 1 FROM message m WHERE m.session_id = s.id)
            ORDER BY COALESCE(s.time_updated, s.time_created, 0) DESC LIMIT 12
        """).fetchall()
        for sid, title, sdir, ts in rows:
            proj = os.path.basename(sdir.rstrip("/")) or "workspace"
            print(f"{sid}|{title[:42]}|{proj}|{fmt_ts(ts)}")

elif parser == "manicode_json":
    root = os.path.expanduser(meta.get("sessions_dir", "~/.config/manicode/projects"))
    found = []
    for cf in glob.glob(os.path.join(root, "*", "chats", "*", "chat-messages.json")):
        try:
            data = json.load(open(cf))
            if not data: continue
            cdir = os.path.dirname(cf)
            cid = os.path.basename(cdir)
            proj = os.path.basename(os.path.dirname(os.path.dirname(cdir)))
            mt = os.path.getmtime(cf)
            title = f"Chat {cid[:14]}"
            for msg in data:
                if isinstance(msg, dict) and msg.get("role") == "user":
                    txt = str(msg.get("content", "")).strip().splitlines()[0]
                    if txt and not txt.startswith("Read .bridge-handoff.md"):
                        title = txt[:42]; break
            found.append((mt, cid, title, proj))
        except Exception:
            pass
    for mt, cid, title, proj in sorted(found, reverse=True)[:12]:
        print(f"{cid}|{title}|{proj}|{fmt_ts(mt)}")

elif parser == "claude_jsonl":
    root = os.path.expanduser(meta.get("sessions_dir", "~/.claude/projects"))
    found = []
    for jf in glob.glob(os.path.join(root, "*", "*.jsonl")):
        try:
            if os.path.getsize(jf) < 50: continue
            sid = os.path.splitext(os.path.basename(jf))[0]
            proj = os.path.basename(os.path.dirname(jf))[-20:]
            mt = os.path.getmtime(jf)
            title = f"Session {sid[:12]}"
            for line in open(jf):
                obj = json.loads(line)
                if obj.get("type") == "user":
                    msg = obj.get("message", {})
                    c = msg.get("content", "") if isinstance(msg, dict) else str(msg)
                    if isinstance(c, list):
                        c = " ".join(x.get("text", "") for x in c if isinstance(x, dict))
                    c = str(c).strip().splitlines()[0]
                    if c: title = c[:42]; break
            found.append((mt, sid, title, proj))
        except Exception:
            pass
    for mt, sid, title, proj in sorted(found, reverse=True)[:12]:
        print(f"{sid}|{title}|{proj}|{fmt_ts(mt)}")

elif parser == "markdown_file":
    hf = os.path.join(cwd, meta.get("history_file", ".aider.chat.history.md"))
    if os.path.isfile(hf) and os.path.getsize(hf) > 0:
        print(f"aider-local|Aider Chat History|{os.path.basename(cwd)}|{fmt_ts(os.path.getmtime(hf))}")

print(f"git-diff|Current Git Diff & Recent Commits|{os.path.basename(cwd)}|live")
PY
}

# --- Build .bridge-handoff.md with Linear Progress Bar ---
build_handoff_package() {
  local SRC_AGENT="$1" SRC_SID="$2" TGT_AGENT="$3"
  local OUT_MD="$PWD/.bridge-handoff.md"
  echo ""
  draw_progress 15 "Securing .git/info/exclude..."
  if [ -d "$PWD/.git" ]; then
    {
      mkdir -p "$PWD/.git/info"
      grep -qxF ".bridge-handoff.md" "$PWD/.git/info/exclude" 2>/dev/null || echo ".bridge-handoff.md" >> "$PWD/.git/info/exclude"
      git tag -f opencode-latest >/dev/null 2>&1
    } 2>/dev/null || true
  fi
  sleep 0.08

  draw_progress 45 "Extracting ${SRC_AGENT} session context..."
  local CONTEXT_BODY
  CONTEXT_BODY=$(python3 - "$AGENTS_CFG" "$SRC_AGENT" "$SRC_SID" "$PWD" << 'PY'
import json, os, sys, glob, sqlite3
cfg = json.load(open(sys.argv[1]))
key, sid, cwd = sys.argv[2], sys.argv[3], sys.argv[4]
meta = cfg.get(key, {})
parser = meta.get("parser", "git_diff")
out = []
try:
    if sid != "git-diff":
        if parser == "sqlite_opencode":
            db = os.path.expanduser(meta.get("db", "~/.local/share/opencode/opencode.db"))
            if os.path.isfile(db):
                con = sqlite3.connect(db)
                q = """SELECT json_extract(m.data, '$.role'), json_extract(p.data, '$.type'),
                              json_extract(p.data, '$.text'), json_extract(p.data, '$.tool'),
                              json_extract(p.data, '$.state.input')
                       FROM message m JOIN part p ON p.message_id = m.id
                       WHERE m.session_id = ? ORDER BY m.rowid ASC, p.rowid ASC"""
                touched = []
                for role, ptype, body, tool, tinput in con.execute(q, (sid,)).fetchall()[-40:]:
                    if ptype == "text" and body:
                        out.append("### " + str(role or "msg").upper() + "\n" + str(body).strip()[:1800])
                    elif tool:
                        inp = str(tinput or "")[:220]
                        touched.append(f"- `{tool}`: {inp}")
                if touched:
                    out.append("### OPENCODE TOOL & FILE ACTIONS (RECENT)\n" + "\n".join(touched[-20:]))
        elif parser == "manicode_json":
            root = os.path.expanduser(meta.get("sessions_dir", "~/.config/manicode/projects"))
            m = glob.glob(os.path.join(root, "*", "chats", sid, "chat-messages.json"))
            if m:
                raw = json.load(open(m[0]))
                msgs = raw if isinstance(raw, list) else raw.get("messages", [])
                for msg in msgs[-16:]:
                    if isinstance(msg, dict) and msg.get("content"):
                        out.append("### " + str(msg.get("role", "msg")).upper() + "\n" + str(msg["content"]).strip()[:1500])
        elif parser == "claude_jsonl":
            root = os.path.expanduser(meta.get("sessions_dir", "~/.claude/projects"))
            m = glob.glob(os.path.join(root, "*", f"{sid}.jsonl"))
            if m:
                for line in open(m[0]).readlines()[-20:]:
                    obj = json.loads(line)
                    if obj.get("type") in ("user", "assistant"):
                        msg = obj.get("message", {})
                        c = msg.get("content", "") if isinstance(msg, dict) else str(msg)
                        if isinstance(c, list):
                            c = "\n".join(x.get("text", "") for x in c if isinstance(x, dict) and x.get("text"))
                        if c:
                            out.append("### " + str(obj["type"]).upper() + "\n" + str(c).strip()[:1500])
        elif parser == "markdown_file":
            hf = os.path.join(cwd, meta.get("history_file", ".aider.chat.history.md"))
            if os.path.isfile(hf):
                out.append(open(hf).read()[-8000:])
except Exception as ex:
    out.append(f"_Transcript fallback ({ex}); relying on live Git state below._")
print("\n\n".join(out) if out else "_No prior transcript parsed; relying on live Git state below._")
PY
)

  draw_progress 75 "Capturing Git status, commits & working diff..."
  local GIT_STATUS="" GIT_LOG="" GIT_DIFF=""
  if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    GIT_STATUS=$(git status -sb 2>/dev/null || true)
    GIT_LOG=$(git log -n 5 --oneline 2>/dev/null || true)
    GIT_DIFF=$(git diff HEAD 2>/dev/null | head -c 14000 || true)
  fi
  sleep 0.08

  draw_progress 100 "Writing .bridge-handoff.md for ${TGT_AGENT}..."
  cat << MD > "$OUT_MD"
# Cross-Agent Handoff (${SRC_AGENT} -> ${TGT_AGENT})
- **Workspace:** \`$PWD\`
- **Source Session:** \`$SRC_SID\`
- **Generated:** $(date -u +"%Y-%m-%d %H:%M UTC")

## Mandatory Agent Rules\n- Read this entire file and inspect `git status` + `git diff` BEFORE modifying any file.\n- Do NOT rewrite or revert existing uncommitted changes unless fixing an explicit bug.\n- Keep changes minimal, surgical, and aligned with the project's existing architecture.\n\n## Recent Conversation Context
$CONTEXT_BODY

## Git Repository State
\`\`\`text
$GIT_STATUS
\`\`\`

### Recent Commits
\`\`\`text
$GIT_LOG
\`\`\`

### Working Diff
\`\`\`diff
$GIT_DIFF
\`\`\`
MD
}

launch_target_agent() {
  local TGT_AGENT="$1" TGT_SID="${2:-}"
  local LAUNCH_CMD
  LAUNCH_CMD=$(python3 - "$AGENTS_CFG" "$TGT_AGENT" "$TGT_SID" << 'PY'
import json, sys
cfg = json.load(open(sys.argv[1]))
meta = cfg.get(sys.argv[2], {})
sid = sys.argv[3]
if sid and sid != "new" and "{session_id}" in meta.get("resume_cmd", ""):
    print(meta["resume_cmd"].format(session_id=sid))
else:
    print(meta.get("new_cmd", meta.get("bin", sys.argv[2])))
PY
)
  echo -e "\n  ${G}✓${Z} Handoff ready in ${B}.bridge-handoff.md${Z}"
  echo -e "  ${C}›${Z} Tell ${B}${TGT_AGENT}${Z}: ${D}\"Read .bridge-handoff.md and continue\"${Z}"
  echo -e "  ${C}●${Z} Launching: ${B}${LAUNCH_CMD}${Z}\n"
  eval "exec $LAUNCH_CMD"
}

# --- Git Health Audit ---
run_git_health() {
  echo -e "\n  ${B}git health${Z} ${D}· $PWD${Z}\n  ${D}------------------------------------------${Z}"
  if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    echo -e "  ${Y}●${Z} Not inside a Git repository.\n"
    return 0
  fi
  run_with_spinner "Auditing index, locks & objects..." git fsck --no-dangling || true
  local LOCKS; LOCKS=$(find .git -name "*.lock" 2>/dev/null || true)
  if [ -n "$LOCKS" ]; then
    echo -e "  ${Y}●${Z} Stale lock files found:\n$LOCKS"
    printf "  ${C}›${Z} Remove stale lock files? [y/N]: "; read -r RL
    [[ "$RL" =~ ^[yY] ]] && find .git -name "*.lock" -delete && echo -e "  ${G}✓${Z} Locks cleared."
  else
    echo -e "  ${G}✓${Z} No stale .lock files"
  fi
  echo -e "  ${G}✓${Z} Branch: ${B}$(git branch --show-current 2>/dev/null || echo detached)${Z}"
  echo -e "  ${G}✓${Z} Status: $(git status -s | wc -l | tr -d " ") modified file(s)\n"
}

# --- Selective Multi-Agent Backup & Restore with Progress Bar ---
find_download_dir() {
  for CAND in "/sdcard/Download" "/storage/emulated/0/Download" "/data/data/com.termux/files/home/storage/downloads" "$HOME/Downloads"; do
    if [ -d "$CAND" ] && [ -w "$CAND" ]; then echo "$CAND"; return 0; fi
  done
  return 1
}

run_tool_backup() {
  local PRE_SCOPE="${1:-}"
  command -v zstd >/dev/null 2>&1 || { echo -e "  ${R}●${Z} zstd not installed (apt install -y zstd)"; return 1; }
  local DL_ROOT; DL_ROOT=$(find_download_dir) || { echo -e "  ${R}●${Z} Download folder not accessible."; return 1; }

  mapfile -t INSTALLED < <(detect_installed_agents)
  if [ ${#INSTALLED[@]} -eq 0 ]; then
    echo -e "  ${Y}●${Z} No supported agents detected on PATH.\n"; return 1
  fi

  local SCOPE="$PRE_SCOPE"
  if [ -z "$SCOPE" ]; then
    echo -e "\n  ${B}tool backup${Z} ${D}· selective zstd archive${Z}\n  ${D}------------------------------------------${Z}"
    echo -e "  ${B}[1]${Z} All detected tools ${D}(${#INSTALLED[@]} agent(s))${Z}"
    local I=2
    for ROW in "${INSTALLED[@]}"; do
      IFS="|" read -r K L P _ <<< "$ROW"
      echo -e "  ${B}[$I]${Z} $L ${D}($K)${Z}"
      I=$((I+1))
    done
    echo -e "  ${B}[$I]${Z} Cancel"
    SC=$(read_choice "  ${C}›${Z} Target scope [1-${I}]: " 1 "$I")
    [ "$SC" = "CANCEL" ] && return 0
    if [ "$SC" = "$I" ] || [ "$SC" = "q" ]; then echo -e "  ${D}Backup cancelled.${Z}\n"; return 0; fi
    if [ "$SC" = "1" ]; then SCOPE="all"
    else
      local IDX=$((SC-2))
      [ "$IDX" -ge 0 ] && [ "$IDX" -lt ${#INSTALLED[@]} ] || return 0
      SCOPE="${INSTALLED[$IDX]%%|*}"
    fi
  fi

  mapfile -t PATHS < <(python3 - "$AGENTS_CFG" "$SCOPE" << 'PY'
import json, os, shutil, sys
cfg = json.load(open(sys.argv[1]))
scope = sys.argv[2]
keys = list(cfg.keys()) if scope == "all" else [scope]
seen = set()
for k in keys:
    meta = cfg.get(k, {})
    b = shutil.which(meta.get("bin", k))
    if not b and scope == "all": continue
    for raw in meta.get("backup_paths", []):
        p = os.path.expanduser(raw)
        if os.path.exists(p) and p not in seen:
            seen.add(p); print(p.lstrip("/"))
    if b and os.path.exists(b):
        if b not in seen: seen.add(b); print(b.lstrip("/"))
        rp = os.path.realpath(b)
        if os.path.exists(rp) and rp not in seen:
            seen.add(rp); print(rp.lstrip("/"))
if scope == "all" and os.path.exists("/usr/local/bin/oc-auto"):
    print("usr/local/bin/oc-auto")
PY
)

  if [ ${#PATHS[@]} -eq 0 ]; then
    echo -e "  ${Y}●${Z} No files found for ${SCOPE}.\n"; return 1
  fi

  local DEST_DIR="$DL_ROOT/TOOL BACKUP"
  mkdir -p "$DEST_DIR"
  local OUT_FILE="$DEST_DIR/ocb-${SCOPE}-$(date +%Y%m%d-%H%M%S).tzst"

  echo ""
  draw_progress 10 "Calculating archive size (${#PATHS[@]} target(s))..."
  local TOTAL_BYTES=0
  for P in "${PATHS[@]}"; do
    local SZ; SZ=$(du -sb "/$P" 2>/dev/null | cut -f1 || echo 0)
    TOTAL_BYTES=$(( TOTAL_BYTES + SZ ))
  done
  [ "$TOTAL_BYTES" -le 0 ] && TOTAL_BYTES=1048576

  tar -C / --ignore-failed-read -cf - "${PATHS[@]}" 2>/dev/null | zstd -T0 -9 -q -o "$OUT_FILE" &
  local TPID=$!
  while kill -0 "$TPID" 2>/dev/null; do
    local CUR_SZ; CUR_SZ=$(stat -c%s "$OUT_FILE" 2>/dev/null || echo 0)
    # Estimate compressed ratio (~35% of raw) so bar progresses smoothly 15%..95%
    local EST_PCT=$(( 15 + (CUR_SZ * 220 / TOTAL_BYTES) ))
    [ "$EST_PCT" -gt 95 ] && EST_PCT=95
    draw_progress "$EST_PCT" "Compressing ${SCOPE} (.tzst)..."
    sleep 0.15
  done
  wait "$TPID"
  draw_progress 100 "Saved Download/TOOL BACKUP/$(basename "$OUT_FILE") ($(du -h "$OUT_FILE" | cut -f1))"
  echo ""
}

run_tool_restore() {
  local CLI_MODE="${1:-0}"
  command -v zstd >/dev/null 2>&1 || { echo -e "  ${R}●${Z} zstd not installed (apt install -y zstd)"; return 1; }
  local DL_ROOT; DL_ROOT=$(find_download_dir) || { echo -e "  ${R}●${Z} Download folder not accessible."; return 1; }
  local DEST_DIR="$DL_ROOT/TOOL BACKUP"

  if [ ! -d "$DEST_DIR" ]; then
    echo -e "\n  ${Y}●${Z} No TOOL BACKUP folder found in Download."
    [ "$CLI_MODE" -eq 1 ] && return 1
    back_to_menu_loader; return 0
  fi

  mapfile -t ARCHIVES < <(ls -1t "$DEST_DIR"/*.tzst 2>/dev/null || true)
  if [ ${#ARCHIVES[@]} -eq 0 ]; then
    echo -e "\n  ${Y}●${Z} No .tzst backups found in Download/TOOL BACKUP."
    [ "$CLI_MODE" -eq 1 ] && return 1
    back_to_menu_loader; return 0
  fi

  echo -e "\n  ${B}tool restore${Z} ${D}· Download/TOOL BACKUP${Z}\n  ${D}------------------------------------------${Z}"
  local I=1
  for A in "${ARCHIVES[@]}"; do
    echo -e "  ${B}[$I]${Z} $(basename "$A") ${D}· $(du -h "$A" | cut -f1)${Z}"
    I=$((I+1))
  done
  echo -e "  ${B}[$I]${Z} Cancel"
  RC=$(read_choice "  ${C}›${Z} Select backup [1-${I}]: " 1 "$I")
  [ "$RC" = "CANCEL" ] && return 0
  if [ "$RC" = "$I" ] || [ "$RC" = "q" ] || [ "$RC" -lt 1 ] 2>/dev/null || [ "$RC" -gt "$I" ] 2>/dev/null; then
    echo -e "  ${D}Restore cancelled.${Z}\n"; return 0
  fi

  local PICK="${ARCHIVES[$((RC-1))]}"
  mapfile -t INSTALLED < <(detect_installed_agents)
  echo -e "\n  ${D}Which tool(s) should be restored from $(basename "$PICK")?${Z}"
  echo -e "  ${B}[1]${Z} Everything in archive"
  local J=2
  for ROW in "${INSTALLED[@]}"; do
    IFS="|" read -r K L _ _ <<< "$ROW"
    echo -e "  ${B}[$J]${Z} $L only ${D}($K)${Z}"
    J=$((J+1))
  done
  echo -e "  ${B}[$J]${Z} Cancel"
  RS=$(read_choice "  ${C}›${Z} Restore scope [1-${J}]: " 1 "$J")
  [ "$RS" = "CANCEL" ] && return 0
  if [ "$RS" = "$J" ] || [ "$RS" = "q" ]; then echo -e "  ${D}Restore cancelled.${Z}\n"; return 0; fi

  local SCOPE="all"
  if [ "$RS" != "1" ]; then
    local IDX=$((RS-2))
    [ "$IDX" -ge 0 ] && [ "$IDX" -lt ${#INSTALLED[@]} ] || return 0
    SCOPE="${INSTALLED[$IDX]%%|*}"
  fi

  local LIST_TMP; LIST_TMP=$(mktemp)
  zstd -dc "$PICK" | tar -tf - | python3 - "$SCOPE" << 'PY' > "$LIST_TMP"
import sys
scope = sys.argv[1].lower()
aliases = {"freebuff": ("freebuff", "manicode")}
keys = aliases.get(scope, (scope,))
for line in sys.stdin:
    p = line.rstrip("\n")
    if scope == "all" or any(k in p.lower() for k in keys):
        print(p)
PY

  if [ ! -s "$LIST_TMP" ]; then
    rm -f "$LIST_TMP"
    echo -e "  ${Y}●${Z} Archive contains no ${SCOPE} files.\n"
    [ "$CLI_MODE" -eq 1 ] && return 1
    back_to_menu_loader; return 0
  fi

  printf "  ${Y}›${Z} Restore ${B}${SCOPE}${Z} from $(basename "$PICK")? [y/N]: "; read -r OK
  if [[ "$OK" =~ ^[yY] ]]; then
    echo ""
    draw_progress 25 "Decompressing $(basename "$PICK")..."
    zstd -dc "$PICK" | tar -C / -xf - -T "$LIST_TMP" &
    local EPID=$!
    local P=35
    while kill -0 "$EPID" 2>/dev/null; do
      draw_progress "$P" "Extracting ${SCOPE} files..."
      P=$(( P + 12 )); [ "$P" -gt 92 ] && P=92
      sleep 0.15
    done
    wait "$EPID"
    chmod +x /usr/local/bin/oc-auto 2>/dev/null || true
    draw_progress 100 "Restored ${SCOPE} cleanly"
    echo ""
  else
    echo -e "  ${D}Restore cancelled.${Z}\n"
  fi
  rm -f "$LIST_TMP"
}

# --- User-Controlled Multi-Agent Bridge Flow ---
uninstall_ocb() {
  echo -e "\n  ${B}uninstall ocb${Z}\n  ${D}------------------------------------------${Z}"
  echo -e "  ${Y}Will remove:${Z}"
  echo -e "   • /usr/local/bin/oc-auto (Ubuntu proot engine)"
  echo -e "   • ~/.config/ocb (agent registry & settings)"
  echo -e "   • \$PREFIX/bin/ocb (Termux wrapper command)"
  echo -e "\n  ${G}Will preserve:${Z}"
  echo -e "   • Download/TOOL BACKUP (.tzst archives)"
  echo -e "   • All AI agent configs, databases & project Git repos\n"

  printf "  ${C}›${Z} Type ${B}UNINSTALL${Z} to confirm (or anything else to cancel): " >/dev/tty
  IFS= read -r CONF </dev/tty || exit 130
  if [ "$CONF" != "UNINSTALL" ]; then
    echo -e "  ${D}Uninstall cancelled.${Z}\n"
    return 0
  fi

  rm -rf "$HOME/.config/ocb"
  rm -f /usr/local/bin/oc-auto
  echo -e "  ${G}✓${Z} Removed Ubuntu engine and config."
  exit 99
}

run_bridge_wizard() {
  local SRC_AGENT="${1:-}" TGT_AGENT="${2:-}" FORCE_NEW="${3:-0}"
  run_with_spinner "Scanning installed CLI agents..." detect_installed_agents
  mapfile -t AGENTS <<< "$SPINNER_OUT"

  if [ ${#AGENTS[@]} -eq 0 ]; then
    echo -e "  ${R}●${Z} No supported agents found on PATH. Edit ${B}$AGENTS_CFG${Z} to register tools.\n"
    return 1
  fi

  # 1. Select Source Agent if not supplied via CLI
  if [ -z "$SRC_AGENT" ]; then
    echo -e "\n  ${B}step 1/3 · choose source tool${Z}\n  ${D}------------------------------------------${Z}"
    local I=1
    for ROW in "${AGENTS[@]}"; do
      IFS="|" read -r K L P _ <<< "$ROW"
      echo -e "  ${B}[$I]${Z} $L ${D}· $K ($P)${Z}"
      I=$((I+1))
    done
    echo -e "  ${B}[$I]${Z} Back to main menu"
    SC=$(read_choice "  ${C}›${Z} Source tool [1-${I}]: " 1 "$I"); [ "$SC" = "CANCEL" ] && return 0
    [ "$SC" = "$I" ] || [ "$SC" = "q" ] && return 0
    SRC_AGENT="${AGENTS[$((SC-1))]%%|*}"
  fi

  # 2. Select Source Session
  run_with_spinner "Loading ${SRC_AGENT} sessions..." list_agent_sessions "$SRC_AGENT"
  mapfile -t SESSIONS <<< "$SPINNER_OUT"
  echo -e "\n  ${B}step 2/3 · choose ${SRC_AGENT} session${Z}\n  ${D}------------------------------------------${Z}"
  local J=1
  for SROW in "${SESSIONS[@]}"; do
    IFS="|" read -r SID STITLE SPROJ STS <<< "$SROW"
    echo -e "  ${B}[$J]${Z} $STITLE ${D}· $SPROJ · $STS${Z}"
    J=$((J+1))
  done
  echo -e "  ${B}[$J]${Z} Cancel"
  SSC=$(read_choice "  ${C}›${Z} Session [1-${J}]: " 1 "$J"); [ "$SSC" = "CANCEL" ] && return 0
  [ "$SSC" = "$J" ] || [ "$SSC" = "q" ] && return 0
  local PICK_SID="${SESSIONS[$((SSC-1))]%%|*}"

  # 3. Select Target Agent if not supplied via CLI
  if [ -z "$TGT_AGENT" ]; then
    echo -e "\n  ${B}step 3/3 · choose target tool${Z}\n  ${D}------------------------------------------${Z}"
    local K_IDX=1
    local CANDS=()
    for ROW in "${AGENTS[@]}"; do
      IFS="|" read -r K L P _ <<< "$ROW"
      [ "$K" = "$SRC_AGENT" ] && [ ${#AGENTS[@]} -gt 1 ] && continue
      CANDS+=("$K")
      echo -e "  ${B}[$K_IDX]${Z} $L ${D}· hand off into $K${Z}"
      K_IDX=$((K_IDX+1))
    done
    echo -e "  ${B}[$K_IDX]${Z} Cancel"
    TC=$(read_choice "  ${C}›${Z} Target tool [1-${K_IDX}]: " 1 "$K_IDX"); [ "$TC" = "CANCEL" ] && return 0
    [ "$TC" = "$K_IDX" ] || [ "$TC" = "q" ] && return 0
    TGT_AGENT="${CANDS[$((TC-1))]}"
  fi

  # 4. Resume existing target thread or start new
  local TGT_SID="new"
  if [ "$FORCE_NEW" -eq 0 ]; then
    run_with_spinner "Checking ${TGT_AGENT} threads..." list_agent_sessions "$TGT_AGENT"
    mapfile -t TSESSIONS <<< "$SPINNER_OUT"
    if [ ${#TSESSIONS[@]} -gt 1 ]; then
      echo -e "\n  ${D}Target ${TGT_AGENT} thread:${Z}"
      echo -e "  ${B}[1]${Z} New fresh thread"
      local M=2
      for TROW in "${TSESSIONS[@]}"; do
        IFS="|" read -r TSID TTITLE TPROJ TTS <<< "$TROW"
        [ "$TSID" = "git-diff" ] && continue
        echo -e "  ${B}[$M]${Z} Resume: $TTITLE ${D}· $TTS${Z}"
        M=$((M+1))
      done
      THC=$(read_choice "  ${C}›${Z} Thread [1-$((M-1))]: " 1 "$((M-1))"); [ "$THC" = "CANCEL" ] && return 0
      if [ "$THC" -gt 1 ] 2>/dev/null; then
        TGT_SID="${TSESSIONS[$((THC-2))]%%|*}"
      fi
    fi
  fi

  build_handoff_package "$SRC_AGENT" "$PICK_SID" "$TGT_AGENT"
  launch_target_agent "$TGT_AGENT" "$TGT_SID"
}

# --- Direct CLI Control Subcommands ---
case "${1:-}" in
  -v|--version) echo "ocb v$VERSION"; exit 0 ;;
  -h|--help)
    echo "Usage: ocb [command]"
    echo "  ocb                         Interactive user-controlled menu"
    echo "  ocb bridge [src] [tgt]      Start cross-agent handoff (optional --new)"
    echo "  ocb agents                  List detected tools & config path"
    echo "  ocb backup [all|<agent>]    Create .tzst backup in Download/TOOL BACKUP"
    echo "  ocb restore                 Restore tools from Download/TOOL BACKUP"
    echo "  ocb health                  Audit Git index, locks & checkpoint tags"
    exit 0 ;;
  agents)
    run_with_spinner "Detecting installed agents..." detect_installed_agents
    echo -e "\n  ${B}detected agents${Z} ${D}· $AGENTS_CFG${Z}\n  ${D}------------------------------------------${Z}"
    while IFS="|" read -r K L P PARSER; do
      [ -z "$K" ] && continue
      echo -e "  ${G}●${Z} ${B}$L${Z} ($K) ${D}→ $P [$PARSER]${Z}"
    done <<< "$SPINNER_OUT"
    echo ""; exit 0 ;;
  bridge)
    FORCE_NEW=0; [[ "${4:-}" = "--new" || "${3:-}" = "--new" ]] && FORCE_NEW=1
    SRC="${2:-}"; TGT="${3:-}"; [ "$TGT" = "--new" ] && TGT=""
    run_bridge_wizard "$SRC" "$TGT" "$FORCE_NEW"; exit 0 ;;
  --health|health) run_git_health; exit 0 ;;
  --backup|backup) run_tool_backup "${2:-}"; exit 0 ;;
  --restore|restore) run_tool_restore 1; exit 0 ;;
esac

# --- Interactive Control Menu ---
while true; do
  run_with_spinner "Scanning workspace & agents..." detect_installed_agents
  mapfile -t DET <<< "$SPINNER_OUT"
  DET_NAMES=$(printf "%s\n" "${DET[@]}" | cut -d"|" -f1 | paste -sd " · " -)
  [ -z "$DET_NAMES" ] && DET_NAMES="none detected"

  echo ""
  echo -e "  ${M}█▀▀█ █▀▀ █▀▀▄${Z}   ${B}ocb${Z} ${C}v$VERSION${Z}"
  echo -e "  ${M}█  █ █   █▀▀▄${Z}   ${D}cross-agent control · $(basename "$PWD")${Z}"
  echo -e "  ${M}▀▀▀▀ ▀▀▀ ▀▀▀ ${Z}   ${D}tools: $DET_NAMES${Z}"
  echo -e "  ${D}------------------------------------------${Z}\n"
  echo -e "  ${D}HANDOFF CONTROL${Z}"
  echo -e "  ${B}[1]${Z} Bridge agents"
  echo -e "      $DOT ${D}Choose source tool, session & target tool${Z}\n"
  echo -e "  ${D}WORKSPACE & TOOLS${Z}"
  echo -e "  ${B}[2]${Z} New project folder"
  echo -e "      $DOT ${D}Create/switch to ~/projects/<name> & init Git${Z}"
  echo -e "  ${B}[3]${Z} Git health"
  echo -e "      $DOT ${D}Audit index, stale locks & checkpoint tags${Z}"
  echo -e "  ${B}[4]${Z} Backup tools"
  echo -e "      $DOT ${D}Selective .tzst snapshot to Download/TOOL BACKUP${Z}"
  echo -e "  ${B}[5]${Z} Restore tools"
  echo -e "      $DOT ${D}Selective restore from Download/TOOL BACKUP${Z}"
  echo -e "  ${B}[6]${Z} Agents registry"
  echo -e "      $DOT ${D}Inspect detected CLIs & ~/.config/ocb/agents.json${Z}"
  echo -e "  ${B}[7]${Z} Uninstall ocb\n      ${D}• Remove ocb binary & config (keeps backups)${Z}"
  echo -e "  ${B}[8]${Z} Exit"
  echo -e "      $DOT ${D}Close without launching an agent${Z}"
  echo -e "  ${D}------------------------------------------${Z}"
  CH=$(read_choice "  ${C}›${Z} Select [1-8]: " 1 8); [ "$CH" = "CANCEL" ] && exit 0

  case "$CH" in
    1) run_bridge_wizard ;;
    2)
      printf "  ${C}›${Z} Project folder name under ~/projects/: "; read -r PNAME
      if [ -n "$PNAME" ]; then
        mkdir -p "$PROJECTS_ROOT/$PNAME" && cd "$PROJECTS_ROOT/$PNAME"
        [ ! -d .git ] && git init -b main >/dev/null 2>&1 || true
        echo -e "  ${G}✓${Z} Switched to ${B}$PWD${Z}\n"
      fi ;;
    3) run_git_health ;;
    4) run_tool_backup ;;
    5) run_tool_restore 0 ;;
    6) "$0" agents ;;
    7|q|Q) exit 0 ;;
  esac
done
