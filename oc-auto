uninstall_ocb() {
  echo -e "\n  ${B}uninstall ocb${Z}\n  ${D}------------------------------------------${Z}"
  echo -e "  ${Y}Will remove:${Z}"
  echo -e "   • /usr/local/bin/oc-auto (Ubuntu proot engine)"
  echo -e "   • ~/.config/ocb (agent registry & settings)"
  echo -e "   • \$PREFIX/bin/ocb (Termux wrapper command)"
  echo -e "\n  ${G}Will preserve:${Z}"
  echo -e "   • Download/TOOL BACKUP (.tzst archives)"
  echo -e "   • All AI agent configs, databases & project Git repos\n"

  printf "  ${C}›${Z} Type ${B}UNINSTALL${Z} to confirm (or anything else to cancel): " >/dev/tty
  IFS= read -r CONF </dev/tty || exit 130
  if [ "$CONF" != "UNINSTALL" ]; then
    echo -e "  ${D}Uninstall cancelled.${Z}\n"
    return 0
  fi

  rm -rf "$HOME/.config/ocb"
  rm -f /usr/local/bin/oc-auto
  echo -e "  ${G}✓${Z} Removed Ubuntu engine and config."
  exit 99
}

run_bridge_wizard() {
  local SRC_AGENT="${1:-}" TGT_AGENT="${2:-}" FORCE_NEW="${3:-0}"
  run_with_spinner "Scanning installed CLI agents..." detect_installed_agents
  mapfile -t AGENTS <<< "$SPINNER_OUT"

  if [ ${#AGENTS[@]} -eq 0 ]; then
    echo -e "  ${R}●${Z} No supported agents found on PATH. Edit ${B}$AGENTS_CFG${Z} to register tools.\n"
    return 1
  fi

  # 1. Select Source Agent if not supplied via CLI
  if [ -z "$SRC_AGENT" ]; then
    echo -e "\n  ${B}step 1/3 · choose source tool${Z}\n  ${D}------------------------------------------${Z}"
    local I=1
    for ROW in "${AGENTS[@]}"; do
      IFS="|" read -r K L P _ <<< "$ROW"
      echo -e "  ${B}[$I]${Z} $L ${D}· $K ($P)${Z}"
      I=$((I+1))
    done
    echo -e "  ${B}[$I]${Z} Back to main menu"
    SC=$(read_choice "  ${C}›${Z} Source tool [1-${I}]: " 1 "$I"); [ "$SC" = "CANCEL" ] && return 0
    [ "$SC" = "$I" ] || [ "$SC" = "q" ] && return 0
    SRC_AGENT="${AGENTS[$((SC-1))]%%|*}"
  fi

  # 2. Select Source Session
  run_with_spinner "Loading ${SRC_AGENT} sessions..." list_agent_sessions "$SRC_AGENT"
  mapfile -t SESSIONS <<< "$SPINNER_OUT"
  echo -e "\n  ${B}step 2/3 · choose ${SRC_AGENT} session${Z}\n  ${D}------------------------------------------${Z}"
  echo -e "  ${D}* = current workspace · other projects remain available below${Z}"
  local J=1
  for SROW in "${SESSIONS[@]}"; do
    IFS="|" read -r SID STITLE SPROJ STS <<< "$SROW"
    echo -e "  ${B}[$J]${Z} $STITLE ${D}· $SPROJ · $STS${Z}"
    J=$((J+1))
  done
  echo -e "  ${B}[$J]${Z} Cancel"
  SSC=$(read_choice "  ${C}›${Z} Session [1-${J}]: " 1 "$J"); [ "$SSC" = "CANCEL" ] && return 0
  [ "$SSC" = "$J" ] || [ "$SSC" = "q" ] && return 0
  local PICK_SID="${SESSIONS[$((SSC-1))]%%|*}"

  # 3. Select Target Agent if not supplied via CLI
  if [ -z "$TGT_AGENT" ]; then
    echo -e "\n  ${B}step 3/3 · choose target tool${Z}\n  ${D}------------------------------------------${Z}"
    local K_IDX=1
    local CANDS=()
    for ROW in "${AGENTS[@]}"; do
      IFS="|" read -r K L P _ <<< "$ROW"
      [ "$K" = "$SRC_AGENT" ] && [ ${#AGENTS[@]} -gt 1 ] && continue
      CANDS+=("$K")
      echo -e "  ${B}[$K_IDX]${Z} $L ${D}· hand off into $K${Z}"
      K_IDX=$((K_IDX+1))
    done
    echo -e "  ${B}[$K_IDX]${Z} Cancel"
    TC=$(read_choice "  ${C}›${Z} Target tool [1-${K_IDX}]: " 1 "$K_IDX"); [ "$TC" = "CANCEL" ] && return 0
    [ "$TC" = "$K_IDX" ] || [ "$TC" = "q" ] && return 0
    TGT_AGENT="${CANDS[$((TC-1))]}"
  fi

  # 4. Resume existing target thread or start new
  local TGT_SID="new"
  if [ "$FORCE_NEW" -eq 0 ]; then
    run_with_spinner "Checking ${TGT_AGENT} threads..." list_agent_sessions "$TGT_AGENT"
    mapfile -t TSESSIONS <<< "$SPINNER_OUT"
    if [ ${#TSESSIONS[@]} -gt 1 ]; then
      echo -e "\n  ${D}Target ${TGT_AGENT} thread:${Z}"
      echo -e "  ${B}[1]${Z} New fresh thread"
      local M=2
      for TROW in "${TSESSIONS[@]}"; do
        IFS="|" read -r TSID TTITLE TPROJ TTS <<< "$TROW"
        [ "$TSID" = "git-diff" ] && continue
        echo -e "  ${B}[$M]${Z} Resume: $TTITLE ${D}· $TTS${Z}"
        M=$((M+1))
      done
      THC=$(read_choice "  ${C}›${Z} Thread [1-$((M-1))]: " 1 "$((M-1))"); [ "$THC" = "CANCEL" ] && return 0
      if [ "$THC" -gt 1 ] 2>/dev/null; then
        TGT_SID="${TSESSIONS[$((THC-2))]%%|*}"
      fi
    fi
  fi

  if ! build_handoff_package "$SRC_AGENT" "$PICK_SID" "$TGT_AGENT"; then
    echo -e "\n  ${R}●${Z} Handoff aborted; target agent was not launched.${Z}\n"
    return 1
  fi
  launch_target_agent "$TGT_AGENT" "$TGT_SID"
}

# --- Direct CLI Control Subcommands ---
case "${1:-}" in
  -v|--version) echo "ocb v$VERSION"; exit 0 ;;
  -h|--help)
    echo "Usage: ocb [command]"
    echo "  ocb                         Interactive user-controlled menu"
    echo "  ocb bridge [src] [tgt]      Start cross-agent handoff (optional --new)"
    echo "  ocb agents                  List detected tools & config path"
    echo "  ocb backup [all|<agent>]    Create .tzst backup in Download/TOOL BACKUP"
    echo "  ocb restore                 Restore tools from Download/TOOL BACKUP"
    echo "  ocb health                  Audit Git index, locks & checkpoint tags"
    echo "  ocb uninstall               Remove engine, config & wrapper (keeps backups)"
    exit 0 ;;
  agents)
    run_with_spinner "Detecting installed agents..." detect_installed_agents
    echo -e "\n  ${B}detected agents${Z} ${D}· $AGENTS_CFG${Z}\n  ${D}------------------------------------------${Z}"
    while IFS="|" read -r K L P PARSER; do
      [ -z "$K" ] && continue
      echo -e "  ${G}●${Z} ${B}$L${Z} ($K) ${D}→ $P [$PARSER]${Z}"
    done <<< "$SPINNER_OUT"
    echo ""; exit 0 ;;
  bridge)
    FORCE_NEW=0; [[ "${4:-}" = "--new" || "${3:-}" = "--new" ]] && FORCE_NEW=1
    SRC="${2:-}"; TGT="${3:-}"; [ "$TGT" = "--new" ] && TGT=""
    run_bridge_wizard "$SRC" "$TGT" "$FORCE_NEW"; exit 0 ;;
  --health|health) run_git_health; exit 0 ;;
  --backup|backup) run_tool_backup "${2:-}"; exit 0 ;;
  --restore|restore) run_tool_restore 1; exit 0 ;;
  uninstall) uninstall_ocb ;;
esac

