detect_installed_agents() {
  ensure_agents_config
  python3 - "$AGENTS_CFG" << 'PY'
import json, shutil, sys
cfg = json.load(open(sys.argv[1]))
for key, meta in cfg.items():
    b = meta.get("bin", key)
    path = shutil.which(b)
    if path:
        lbl = meta.get("label", key); prs = meta.get("parser", "git_diff"); print(f"{key}|{lbl}|{path}|{prs}")
