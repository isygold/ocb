#!/usr/bin/env bash
set -Eeuo pipefail
trap 'printf "\n  \033[31m●\033[0m Stopped at line %s: %s\n" "$LINENO" "$BASH_COMMAND" >&2' ERR

VERSION="2.0.0"
B="\033[1m"; D="\033[2m"; G="\033[32m"; Y="\033[33m"; R="\033[31m"; C="\033[36m"; M="\033[35m"; Z="\033[0m"
DOT="${M}●${Z}"

CFG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/ocb"
AGENTS_CFG="$CFG_DIR/agents.json"
PROJECTS_ROOT="$HOME/projects"

cleanup_tty() { printf "\033[?25h" 2>/dev/null || true; }
trap cleanup_tty EXIT INT TERM

# --- Visual Progress Utilities ---
draw_progress() {
  local PCT="${1:-0}" LABEL="${2:-Working...}"
  [ "$PCT" -lt 0 ] && PCT=0
  [ "$PCT" -gt 100 ] && PCT=100
  local WIDTH=20
  local FILLED=$(( PCT * WIDTH / 100 ))
  local EMPTY=$(( WIDTH - FILLED ))
  local BAR_FILL="" BAR_EMP=""
  local k=0
  while [ "$k" -lt "$FILLED" ]; do BAR_FILL="${BAR_FILL}█"; k=$((k+1)); done
  k=0
  while [ "$k" -lt "$EMPTY" ]; do BAR_EMP="${BAR_EMP}░"; k=$((k+1)); done
  printf "\r\033[K  ${C}[${G}%s${D}%s${C}]${Z} ${B}%3d%%${Z} ${D}· %s${Z}" "$BAR_FILL" "$BAR_EMP" "$PCT" "$LABEL"
  if [ "$PCT" -eq 100 ]; then printf "\n"; fi
}

run_with_spinner() {
  local LABEL="$1"; shift
  local FRAMES=("⠋" "⠙" "⠹" "⠸" "⠼" "⠴" "⠦" "⠧" "⠇" "⠏")
  local TMP_OUT; TMP_OUT=$(mktemp)
  "$@" >"$TMP_OUT" 2>&1 &
  local PID=$!
  local IDX=0 TICKS=0
  printf "\033[?25l" 2>/dev/null || true
  while kill -0 "$PID" 2>/dev/null; do
    local SEC=$(( TICKS / 10 )).$(( TICKS % 10 ))
    printf "\r\033[K  ${C}%s${Z} ${D}%s (${SEC}s)${Z}" "${FRAMES[$IDX]}" "$LABEL"
    IDX=$(( (IDX + 1) % ${#FRAMES[@]} ))
    TICKS=$(( TICKS + 1 ))
    sleep 0.1
  done
  set +e; wait "$PID"; local RC=$?; set -e
  printf "\r\033[K\033[?25h" 2>/dev/null || true
  while IFS= read -r -t 0.01 -n 1 _ </dev/tty 2>/dev/null; do :; done
  SPINNER_OUT=$(cat "$TMP_OUT")
  rm -f "$TMP_OUT"
  if [ "$RC" -ne 0 ] && [ -n "$SPINNER_OUT" ]; then
    echo -e "  ${R}●${Z} $SPINNER_OUT" >&2
  fi
  return "$RC"
}

back_to_menu_loader() {
  local FRAMES=("⠋" "⠙" "⠹" "⠸" "⠼" "⠴")
  for F in "${FRAMES[@]}"; do
    printf "\r\033[K  ${C}%s${Z} ${D}Returning to main menu...${Z}" "$F"
    sleep 0.12
  done
  printf "\r\033[K\n"
}

read_choice() {
  local PROMPT="$1" MIN="$2" MAX="$3" VAL=""
  while true; do
    printf "%b" "$PROMPT" >/dev/tty
    IFS= read -r VAL </dev/tty || exit 130
    VAL="${VAL//[[:space:]]/}"
    if [ -z "$VAL" ]; then
      printf "  \033[33m●\033[0m Empty input — enter %s-%s (or q to cancel).\n" "$MIN" "$MAX" >/dev/tty
      continue
    fi
    case "$VAL" in q|Q) echo "CANCEL"; return 0 ;; esac
    if [[ "$VAL" =~ ^[0-9]+$ ]] && [ "$VAL" -ge "$MIN" ] && [ "$VAL" -le "$MAX" ]; then
      echo "$VAL"; return 0
    fi
    printf "  \033[33m●\033[0m Invalid — enter %s-%s (or q to cancel).\n" "$MIN" "$MAX" >/dev/tty
  done
}

