}

# --- Session Discovery Across Adapters ---
list_agent_sessions() {
  local AGENT_KEY="$1"
  ensure_agents_config
  python3 - "$AGENTS_CFG" "$AGENT_KEY" "$PWD" << 'PY'
import json, os, sys, glob, sqlite3, datetime

cfg = json.load(open(sys.argv[1]))
key = sys.argv[2]
cwd = os.path.realpath(sys.argv[3])
meta = cfg.get(key, {})
parser = meta.get("parser", "git_diff")

def fmt_ts(ts):
    try:
        if ts > 1e12: ts /= 1000.0
        return datetime.datetime.fromtimestamp(ts).strftime("%m-%d %H:%M")
    except Exception:
        return "recent"

if parser == "sqlite_opencode":
    db = os.path.expanduser(meta.get("db", "~/.local/share/opencode/opencode.db"))
    if os.path.isfile(db):
        # Read-only: listing sessions must never mutate the agent database.
        con = sqlite3.connect(f"file:{db}?mode=ro", uri=True)
        rows = con.execute("""
            SELECT s.id, COALESCE(NULLIF(trim(s.title), ''), s.id), COALESCE(s.directory, ''), COALESCE(s.time_updated, s.time_created, 0)
            FROM session s
            WHERE EXISTS (SELECT 1 FROM message m WHERE m.session_id = s.id)
            ORDER BY COALESCE(s.time_updated, s.time_created, 0) DESC
        """).fetchall()
        con.close()

        current = []
        other = []
        for sid, title, sdir, ts in rows:
            sdir = os.path.expanduser(str(sdir or ""))
            is_current = bool(sdir) and os.path.realpath(sdir) == cwd
            proj = os.path.basename(sdir.rstrip("/")) or "workspace"
            title = str(title).replace("|", "/")[:42]
            proj = proj.replace("|", "/") + ("*" if is_current else "")
            item = (sid, title, proj, ts)
            (current if is_current else other).append(item)

        # Current workspace first; keep other sessions available as fallback.
        for sid, title, proj, ts in (current + other)[:12]:
            print(f"{sid}|{title}|{proj}|{fmt_ts(ts)}")

elif parser == "manicode_json":
    root = os.path.expanduser(meta.get("sessions_dir", "~/.config/manicode/projects"))
    found = []
    for cf in glob.glob(os.path.join(root, "*", "chats", "*", "chat-messages.json")):
        try:
            data = json.load(open(cf))
            if not data: continue
            cdir = os.path.dirname(cf)
            cid = os.path.basename(cdir)
            proj = os.path.basename(os.path.dirname(os.path.dirname(cdir)))
            mt = os.path.getmtime(cf)
            title = f"Chat {cid[:14]}"
            for msg in data:
                if isinstance(msg, dict) and (msg.get("role") or msg.get("variant")) == "user":
                    txt = str(msg.get("content", "")).strip().splitlines()[0]
                    if txt and not txt.startswith("Read .bridge-handoff.md"):
                        title = txt[:42]; break
            is_current = proj == os.path.basename(cwd)
            found.append((not is_current, -mt, cid, str(title).replace("|", "/")[:42], proj.replace("|", "/") + ("*" if is_current else "")))
        except Exception:
            pass
    for _scope, _mt, cid, title, proj in sorted(found)[:12]:
        print(f"{cid}|{title}|{proj}|{fmt_ts(-_mt)}")

elif parser == "claude_jsonl":
    root = os.path.expanduser(meta.get("sessions_dir", "~/.claude/projects"))
    found = []
    for jf in glob.glob(os.path.join(root, "*", "*.jsonl")):
        try:
            if os.path.getsize(jf) < 50: continue
            sid = os.path.splitext(os.path.basename(jf))[0]
            pdir = os.path.basename(os.path.dirname(jf))
            proj = pdir[-20:]
            mt = os.path.getmtime(jf)
            title = f"Session {sid[:12]}"
            session_cwd = ""
            for line in open(jf):
                obj = json.loads(line)
                session_cwd = session_cwd or str(obj.get("cwd", "") or "")
                if obj.get("type") == "user":
                    msg = obj.get("message", {})
                    c = msg.get("content", "") if isinstance(msg, dict) else str(msg)
                    if isinstance(c, list):
                        c = " ".join(x.get("text", "") for x in c if isinstance(x, dict))
                    c = str(c).strip().splitlines()[0]
                    if c: title = c[:42]; break
            is_current = (bool(session_cwd) and os.path.realpath(session_cwd) == cwd) or (pdir == cwd.replace("/", "-"))
            found.append((not is_current, -mt, sid, title.replace("|", "/")[:42], proj.replace("|", "/") + ("*" if is_current else "")))
        except Exception:
            pass
    for _scope, _mt, sid, title, proj in sorted(found)[:12]:
        print(f"{sid}|{title}|{proj}|{fmt_ts(-_mt)}")

elif parser == "markdown_file":
    hf = os.path.join(cwd, meta.get("history_file", ".aider.chat.history.md"))
    if os.path.isfile(hf) and os.path.getsize(hf) > 0:
        print(f"aider-local|Aider Chat History|{os.path.basename(cwd)}|{fmt_ts(os.path.getmtime(hf))}")

print(f"git-diff|Current Git Diff & Recent Commits|{os.path.basename(cwd)}|live")
PY
}

# --- Build .bridge-handoff.md with Linear Progress Bar ---
build_handoff_package() {
  local SRC_AGENT="$1" SRC_SID="$2" TGT_AGENT="$3"
  local OUT_MD="$PWD/.bridge-handoff.md"
  local TOP
  if ! TOP=$(git rev-parse --show-toplevel 2>/dev/null); then
    echo -e "\n  ${R}●${Z} Refusing to create a handoff outside a Git worktree."
    echo -e "  ${D}Open a project repository first, then run ocb again.${Z}"
    return 1
  fi
  if is_protected_root "$PWD" || is_protected_root "$TOP"; then
    echo -e "\n  ${R}●${Z} Refusing to hand off the home directory or filesystem root."
    echo -e "  ${D}Run ocb from a project folder so home files are not exported.${Z}"
    return 1
  fi
  echo ""
  draw_progress 15 "Securing .git/info/exclude..."
  {
    local EXCLUDE
    EXCLUDE=$(git rev-parse --git-path info/exclude 2>/dev/null || echo "$TOP/.git/info/exclude")
    mkdir -p "$(dirname "$EXCLUDE")"
    grep -qxF ".bridge-handoff.md" "$EXCLUDE" 2>/dev/null || printf '%s\n' ".bridge-handoff.md" >> "$EXCLUDE"
    git tag -f opencode-latest >/dev/null 2>&1 || true
  } 2>/dev/null || true
  sleep 0.08

  draw_progress 45 "Extracting ${SRC_AGENT} session context..."
  local CONTEXT_BODY TASK_BODY
  CONTEXT_BODY=$(python3 - "$AGENTS_CFG" "$SRC_AGENT" "$SRC_SID" "$PWD" "$TOP" << 'PY'
import json, os, sys, glob, sqlite3, re
cfg = json.load(open(sys.argv[1]))
key, sid, cwd = sys.argv[2], sys.argv[3], sys.argv[4]
top = os.path.realpath(sys.argv[5]) if len(sys.argv) > 5 and sys.argv[5] else os.path.realpath(cwd)
meta = cfg.get(key, {})
parser = meta.get("parser", "git_diff")
out = []
last_agent_msg = ""
outside_actions = 0
SYSTEM_PREFIXES = ("/dev/", "/proc/", "/sys/", "/usr/", "/bin/", "/sbin/", "/etc/",
                   "/sdcard/", "/system/", "/apex/", "/data/data/com.termux/files/usr/")

def foreign_action(raw):
    for p in re.findall(r"(/[^\s\"'`,;:)]+)", raw):
        if p.startswith(SYSTEM_PREFIXES):
            continue
        if not os.path.realpath(os.path.dirname(p) or "/").startswith(top):
            return True
    return False

def fb_role(msg):
    r = str(msg.get("role") or msg.get("variant") or "msg").lower()
    if r in ("ai", "assistant", "model"):
        return "assistant"
    return "user" if r in ("user", "human") else r

def fb_text(msg):
    txt = str(msg.get("content") or "").strip()
    if txt:
        return txt
    blocks = msg.get("blocks") or []
    if isinstance(blocks, str):
        try:
            blocks = json.loads(blocks)
        except Exception:
            blocks = []
    parts = []
    if isinstance(blocks, list):
        for b in blocks:
            if isinstance(b, dict) and b.get("type") == "text" and b.get("content"):
                # textType='reasoning' marks private thinking; only keep real replies.
                if str(b.get("textType") or "text") != "text":
                    continue
                parts.append(str(b["content"]))
    return "\n".join(parts).strip()
try:
    if sid != "git-diff":
        if parser == "sqlite_opencode":
            db = os.path.expanduser(meta.get("db", "~/.local/share/opencode/opencode.db"))
            if os.path.isfile(db):
                con = sqlite3.connect(db)
                q = """SELECT json_extract(m.data, '$.role'), json_extract(p.data, '$.type'),
                              json_extract(p.data, '$.text'), json_extract(p.data, '$.tool'),
                              json_extract(p.data, '$.state.input')
                       FROM message m JOIN part p ON p.message_id = m.id
                       WHERE m.session_id = ? ORDER BY m.rowid ASC, p.rowid ASC"""
                touched = []
                foreign = 0
                seen_texts = set()
                for role, ptype, body, tool, tinput in con.execute(q, (sid,)).fetchall()[-40:]:
                    if ptype == "text" and body:
                        text = str(body).strip()
                        seen_texts.add(text)
                        out.append("### " + str(role or "msg").upper() + "\n" + text[:1800])
                        if str(role or "") == "assistant":
                            last_agent_msg = text
                    elif tool:
                        raw = str(tinput or "")
                        if foreign_action(raw):
                            foreign += 1
                        else:
                            touched.append(f"- `{tool}`: {raw[:220]}")
                outside_actions = foreign
                # The tail of a long session is mostly tool/step parts, so the last
                # 40 rows can contain no message at all. Fetch messages explicitly.
                texts = con.execute("""SELECT json_extract(m.data, '$.role'), json_extract(p.data, '$.text')
                       FROM message m JOIN part p ON p.message_id = m.id
                       WHERE m.session_id = ? AND json_extract(p.data, '$.type') = 'text'
                         AND json_extract(m.data, '$.role') IN ('user', 'assistant')
                         AND coalesce(json_extract(p.data, '$.text'), '') != ''
                       ORDER BY m.rowid DESC, p.rowid DESC LIMIT 6""", (sid,)).fetchall()
                con.close()
                texts.reverse()
                recent = []
                for role, text in texts:
                    text = str(text or "").strip()
                    if not text or text in seen_texts:
                        continue
                    seen_texts.add(text)
                    recent.append("#### " + str(role).upper() + "\n" + text[:900])
                    if str(role) == "assistant":
                        last_agent_msg = text
                recent_blocks = (["### MOST RECENT MESSAGES (tail of session)\n" + "\n\n".join(recent)] if recent else [])
                if touched:
                    recent_blocks.append("### OPENCODE TOOL & FILE ACTIONS IN THIS WORKSPACE (RECENT)\n" + "\n".join(touched[-20:]))
                out[:0] = recent_blocks
        elif parser == "manicode_json":
            root = os.path.expanduser(meta.get("sessions_dir", "~/.config/manicode/projects"))
            m = glob.glob(os.path.join(root, "*", "chats", sid, "chat-messages.json"))
            if m:
                raw = json.load(open(m[0]))
                msgs = raw if isinstance(raw, list) else raw.get("messages", [])
                for msg in msgs[-16:]:
                    if not isinstance(msg, dict):
                        continue
                    role = fb_role(msg)
                    text = fb_text(msg)
                    if not text or role in ("system", "msg"):
                        continue
                    out.append("### " + role.upper() + "\n" + text[:1500])
                    if role == "assistant":
                        last_agent_msg = text
        elif parser == "claude_jsonl":
            root = os.path.expanduser(meta.get("sessions_dir", "~/.claude/projects"))
            m = glob.glob(os.path.join(root, "*", f"{sid}.jsonl"))
            if m:
                for line in open(m[0]).readlines()[-20:]:
                    obj = json.loads(line)
                    if obj.get("type") in ("user", "assistant"):
                        msg = obj.get("message", {})
                        c = msg.get("content", "") if isinstance(msg, dict) else str(msg)
                        if isinstance(c, list):
                            c = "\n".join(x.get("text", "") for x in c if isinstance(x, dict) and x.get("text"))
                        if c:
                            out.append("### " + str(obj["type"]).upper() + "\n" + str(c).strip()[:1500])
        elif parser == "markdown_file":
            hf = os.path.join(cwd, meta.get("history_file", ".aider.chat.history.md"))
            if os.path.isfile(hf):
                out.append(open(hf).read()[-8000:])
except Exception as ex:
    out.append(f"_Transcript fallback ({ex}); relying on live Git state below._")

task = []
if last_agent_msg:
    task.append("### Where the work stopped (last agent message)\n" + last_agent_msg[-1400:])
else:
    task.append("_No assistant message recovered from the transcript._")
if outside_actions:
    task.append("### Workspace scope\n- " + str(outside_actions) + " recent action(s) in this session touched paths outside `" + top + "` and were omitted.\n- If that was the real work in flight, re-run the bridge from that repository.")
print("<<<TASK>>>")
print("\n\n".join(task))
print("<<<ENDTASK>>>")
if out:
    print("\n\n".join(out))
elif outside_actions:
    print("_Every recent action in this session ran outside the current worktree, so nothing about this repo was captured. Run the bridge from the repo that actually changed._")
else:
    print("_No prior transcript parsed; relying on live Git state below._")
PY
)
  TASK_BODY=$(printf '%s\n' "$CONTEXT_BODY" | sed -n '/^<<<TASK>>>$/,/^<<<ENDTASK>>>$/p' | sed '1d;$d' || true)
  CONTEXT_BODY=$(printf '%s\n' "$CONTEXT_BODY" | sed '/^<<<TASK>>>$/,/^<<<ENDTASK>>>$/d' || true)

  draw_progress 75 "Capturing Git status, commits & working diff..."
  local GIT_STATUS="" GIT_LOG="" GIT_DIFF="" GIT_SHORT="" GIT_SYNC="" GIT_STASH="" GIT_REFLOG="" UNTRACKED_MD="" UF=""
  if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    GIT_STATUS=$(git status -sb 2>/dev/null || true)
    GIT_SHORT=$(git status --short 2>/dev/null | head -40 || true)
    GIT_LOG=$(git log -n 5 --oneline 2>/dev/null || true)
    GIT_REFLOG=$(git reflog -n 5 2>/dev/null || true)
    GIT_STASH=$(git stash list 2>/dev/null | head -10 || true)
    GIT_SYNC=$(git rev-list --left-right --count '@{u}...HEAD' 2>/dev/null | awk '{printf "behind %s / ahead %s", $1, $2}' || true)
    GIT_DIFF=$(git diff HEAD 2>/dev/null | head -c 14000 || true)
    # Untracked files carry in-flight work that never reaches the diff.
    while IFS= read -r UF; do
      [ -n "$UF" ] && [ -f "$UF" ] || continue
      [ "$(wc -c <"$UF" 2>/dev/null || echo 0)" -gt 65536 ] && continue
      LC_ALL=C grep -Iq . "$UF" 2>/dev/null || continue
      UNTRACKED_MD="${UNTRACKED_MD}"$(printf '\n#### %s\n```text\n%s\n```\n' "$UF" "$(head -c 1500 "$UF" 2>/dev/null || true)")
    done < <(git ls-files --others --exclude-standard 2>/dev/null | head -5 || true)
  fi
  sleep 0.08

  draw_progress 100 "Writing .bridge-handoff.md for ${TGT_AGENT}..."
  {
    printf '# Cross-Agent Handoff (%s -> %s)\n' "$SRC_AGENT" "$TGT_AGENT"
    printf -- '- **Workspace:** `%s`\n' "$PWD"
    printf -- '- **Source Session:** `%s`\n' "$SRC_SID"
    printf -- '- **Generated:** %s\n' "$(date -u +"%Y-%m-%d %H:%M UTC")"
    printf '\n## Mandatory Agent Rules\n'
    printf -- '- Read this entire file and inspect `git status` + `git diff` BEFORE modifying any file.\n'
    printf -- '- Do NOT rewrite or revert existing uncommitted changes unless fixing an explicit bug.\n'
    printf '%s\n' "- Keep changes minimal, surgical, and aligned with the project's existing architecture."
    printf '%s\n' "- This handoff is scoped to the worktree above; transcript actions in other directories are not your task."
    printf '%s\n' "- If the working diff below is empty, confirm with the user whether work was in flight before treating the task as finished."
    printf '\n## Task State\n'
    printf '%s\n' "$TASK_BODY"
    if [ -n "$GIT_SYNC" ]; then
      printf -- '- **Upstream sync:** %s\n' "$GIT_SYNC"
    else
      printf -- '- **Upstream sync:** no upstream tracking branch\n'
    fi
    if [ -n "$GIT_SHORT" ]; then
      printf -- '- **Working tree:** %s changed path(s)\n' "$(printf '%s\n' "$GIT_SHORT" | grep -c . || true)"
    else
      printf -- '- **Working tree:** clean\n'
    fi
    if [ -n "$GIT_STASH" ]; then
      printf -- '- **Stashes:** %s\n' "$(printf '%s\n' "$GIT_STASH" | grep -c . || true)"
    fi
    printf '\n### Next step\n'
    printf '%s\n' "- Not recorded by the source session. Infer it from the message above and the working diff, then confirm with the user before large changes."
    printf '\n## Recent Conversation Context\n'
    printf '%s\n' "$CONTEXT_BODY"
    printf '\n## Git Repository State\n'
    printf '```text\n%s\n```\n' "$GIT_STATUS"
    printf '\n### Working Tree (git status --short)\n'
    printf '```text\n%s\n```\n' "${GIT_SHORT:-clean}"
    printf '\n### Recent Commits\n'
    printf '```text\n%s\n```\n' "$GIT_LOG"
    printf '\n### Reflog (last 5)\n'
    printf '```text\n%s\n```\n' "${GIT_REFLOG:-unavailable}"
    if [ -n "$GIT_STASH" ]; then
      printf '\n### Stashes\n'
      printf '```text\n%s\n```\n' "$GIT_STASH"
    fi
    printf '\n### Working Diff\n'
    printf '```diff\n%s\n```\n' "${GIT_DIFF:-_No uncommitted changes._}"
    if [ -n "$UNTRACKED_MD" ]; then
      printf '\n## Untracked Files (contents, first 1500 bytes each)\n'
      printf '%s\n' "$UNTRACKED_MD"
    fi
  } > "$OUT_MD"
  if [ -z "$GIT_SHORT" ] && [ -z "$GIT_DIFF" ]; then
    echo -e "\n  ${Y}●${Z} Working tree is clean — this handoff carries no in-flight changes."
    echo -e "  ${D}If work was half-finished, commit or stash it and re-run the bridge.${Z}"
  fi
}

launch_target_agent() {
  local TGT_AGENT="$1" TGT_SID="${2:-}"
  if [ -n "$TGT_SID" ] && [ "$TGT_SID" != "new" ]; then
    case "$TGT_SID" in
      *[!A-Za-z0-9._:-]*)
        echo -e "\n  ${R}●${Z} Refusing unsafe session id from the agent database."
        return 1
        ;;
    esac
  fi
  local LAUNCH_CMD
  LAUNCH_CMD=$(python3 - "$AGENTS_CFG" "$TGT_AGENT" "$TGT_SID" << 'PY'
import json, sys
cfg = json.load(open(sys.argv[1]))
meta = cfg.get(sys.argv[2], {})
sid = sys.argv[3]
if sid and sid != "new" and "{session_id}" in meta.get("resume_cmd", ""):
    print(meta["resume_cmd"].format(session_id=sid))
else:
    print(meta.get("new_cmd", meta.get("bin", sys.argv[2])))
PY
)
  echo -e "\n  ${G}✓${Z} Handoff ready in ${B}.bridge-handoff.md${Z}"
  echo -e "  ${C}›${Z} Tell ${B}${TGT_AGENT}${Z}: ${D}\"Read .bridge-handoff.md and continue\"${Z}"
  echo -e "  ${C}●${Z} Launching: ${B}${LAUNCH_CMD}${Z}\n"
  exec bash -c "$LAUNCH_CMD"
}

# --- Git Health Audit ---
run_git_health() {
  echo -e "\n  ${B}git health${Z} ${D}· $PWD${Z}\n  ${D}------------------------------------------${Z}"
  if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    echo -e "  ${Y}●${Z} Not inside a Git repository.\n"
    return 0
  fi
  run_with_spinner "Auditing index, locks & objects..." git fsck --no-dangling || true
  local LOCKS; LOCKS=$(find .git -name "*.lock" 2>/dev/null || true)
  if [ -n "$LOCKS" ]; then
    echo -e "  ${Y}●${Z} Stale lock files found:\n$LOCKS"
    printf "  ${C}›${Z} Remove stale lock files? [y/N]: "; read -r RL
    [[ "$RL" =~ ^[yY] ]] && find .git -name "*.lock" -delete && echo -e "  ${G}✓${Z} Locks cleared."
  else
    echo -e "  ${G}✓${Z} No stale .lock files"
  fi
  echo -e "  ${G}✓${Z} Branch: ${B}$(git branch --show-current 2>/dev/null || echo detached)${Z}"
  echo -e "  ${G}✓${Z} Status: $(git status -s | wc -l | tr -d " ") modified file(s)\n"
}

